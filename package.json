{
  "name": "dsh-workbench",
  "version": "1.0.0",
  "type": "module",
  "description": "Workbenches for DSH: scene presets that inject their own system prompt and skill routing into the current session. Ships with 20 captured Doubao workbenches plus a built-in Godot game-development workbench. The data model is platform-neutral, so presets from other products can be imported the same way.",
  "icon": "icon.svg",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "workbench",
    "preset",
    "system-prompt",
    "godot"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "data/custom-workbenches.json",
    "data/build-custom-workbenches.py",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ElioFanyu/dsh-workbench.git"
  },
  "homepage": "https://github.com/ElioFanyu/dsh-workbench#readme",
  "bugs": {
    "url": "https://github.com/ElioFanyu/dsh-workbench/issues"
  }
}
